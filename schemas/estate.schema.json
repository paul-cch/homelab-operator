{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Homelab Operator Example Estate",
  "type": "object",
  "required": ["name", "surfaces", "flows"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "authority"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["repo", "github", "host_checkout", "runtime_export", "live_config", "external_service"]
          },
          "authority": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "proof_required"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "proof_required": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
