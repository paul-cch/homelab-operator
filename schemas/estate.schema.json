{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Homelab Operator Example Estate",
  "type": "object",
  "required": ["name", "surfaces", "flows"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "authority"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["repo", "github", "host_checkout", "runtime_export", "live_config", "external_service"]
          },
          "authority": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "handoff": { "type": "string", "minLength": 1 },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "owner", "proof_required"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "owner": { "type": "string", "minLength": 1 },
                "purpose": { "type": "string", "minLength": 1 },
                "proof_required": {
                  "enum": [
                    "repo_only",
                    "github_coordination",
                    "host_checkout_only",
                    "runtime_export_only",
                    "live_config_only",
                    "external_service_only",
                    "end_to_end",
                    "handoff",
                    "blocked"
                  ]
                },
                "handoff": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "proof_required"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "proof_required": {
            "enum": [
              "repo_only",
              "github_coordination",
              "host_checkout_only",
              "runtime_export_only",
              "live_config_only",
              "external_service_only",
              "end_to_end",
              "handoff",
              "blocked"
            ]
          },
          "intent": { "type": "string", "minLength": 1 },
          "handoff": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
